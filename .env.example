# Reown Cloud / WalletConnect project id. Public, same class as a publishable key.
# Empty (default) keeps injected-wallet-only. Do not commit a real id.
# Next.js inlines NEXT_PUBLIC_* at `next build` / `next dev` (use .env.local locally).
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional Unstoppable Resolution Service key (server-side only).
# Empty (default) keeps on-chain Polygon UNS only; a miss is a quiet empty claim.
# Never put this in NEXT_PUBLIC_*. Do not commit a real key.
UNSTOPPABLE_API_KEY=

# Optional Panopticon TURN allocate (path A). Server-side only.
# All three App Service application settings required for live TURN.
# Empty or any missing (default) keeps STUN + /gun — no error theater on /feed.
# PANOPTICON_TURN_BASE = allocate origin (or origin+/api/v1[/turn]).
# Next hops POST /api/v1/turn/allocate. Hold PANOPTICON_API_KEY in Key Vault
# (kv-fyber-cg47; same habit as SEED_SECRET / IDENTITY_SESSION_SECRET).
# TF in FyberLabs/infra terraform/s3rch wires secret → App Setting.
# Never NEXT_PUBLIC_*. Never Gun. Never the browser. Never commit a real key.
# This repo does not deploy coturn (Path A consume only).
PANOPTICON_TURN_BASE=
PANOPTICON_TENANT_ID=
PANOPTICON_API_KEY=

# Optional Panopticon oracles attest v0. Server-side only.
# PANOPTICON_ORACLES_BASE + shared PANOPTICON_TENANT_ID + PANOPTICON_API_KEY.
# Empty or any missing (default) = no hop — keep browser-first SIWE/ENS/ERC-1271.
# PANOPTICON_ORACLES_BASE = attest origin (or origin+/api/v1[/oracles[/v0]]).
# Next hops POST /api/v1/oracles/v0/attest from session-gated /api/oracles/attest.
# Lab: https://api.test.hyperme.sh. Never NEXT_PUBLIC_*. Never Gun.
# Contract: FyberLabs/panopticon products/oracles/docs/oracles-attest-v0.md
# Payments stay held (PANOPTICON_PAYMENTS_BASE stub). Empty = no hop.
# FyberLabs/panopticon products/payments/docs/payments-access-v0.md
# Ops / smoke: docs/oracles-and-payments-prep.md
PANOPTICON_ORACLES_BASE=
PANOPTICON_PAYMENTS_BASE=

# Optional email/SMS confirm webhook (server-side only). POST { kind, target, code }.
# Empty (default) is honest "not configured" for live send. Non-production uses
# lab fixture code 000000 unless CONFIRM_FIXTURE=0. Never NEXT_PUBLIC_*.
CONFIRM_SEND_URL=
CONFIRM_FIXTURE=

# Optional third-party KYC issuer HTTP (server-side only). Empty keeps the
# fixture issuer (`kyc:fixture:held`). Do not invent a vendor. Never NEXT_PUBLIC_*.
KYC_ISSUER_URL=
