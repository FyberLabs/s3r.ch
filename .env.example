# Reown Cloud / WalletConnect project id. Public, same class as a publishable key.
# Empty (default) keeps injected-wallet-only. Do not commit a real id.
# Next.js inlines NEXT_PUBLIC_* at `next build` / `next dev` (use .env.local locally).
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional Unstoppable Resolution Service key (server-side only).
# Empty (default) keeps on-chain Polygon UNS only; a miss is a quiet empty claim.
# Never put this in NEXT_PUBLIC_*. Do not commit a real key.
UNSTOPPABLE_API_KEY=

# Optional Panopticon TURN allocate (path A). Server-side only.
# All three App Service application settings required for live TURN.
# Empty or any missing (default) keeps STUN + /gun — no error theater on /feed.
# PANOPTICON_TURN_BASE = allocate origin (or origin+/api/v1[/turn]).
# Next hops POST /api/v1/turn/allocate. Hold PANOPTICON_API_KEY in Key Vault
# (kv-fyber-cg47, secret name s3rch-panopticon-api-key).
# FyberLabs/infra terraform/s3rch wires that secret and the *_BASE hostnames.
# PANOPTICON_TENANT_ID is set on App Service by this repo's Deploy workflow
# from GitHub variable S3RCH_PANOPTICON_TENANT_ID (repository or prod
# environment variable). Identifier, not a secret. Do not commit the UUID.
# Never NEXT_PUBLIC_*. Never Gun. Never the browser. Never commit a real key.
# This repo does not deploy coturn (Path A consume only).
PANOPTICON_TURN_BASE=
PANOPTICON_TENANT_ID=
PANOPTICON_API_KEY=

# Optional Panopticon oracles attest v0. Server-side only.
# PANOPTICON_ORACLES_BASE + shared PANOPTICON_TENANT_ID + PANOPTICON_API_KEY.
# Empty or any missing (default) = no hop — keep browser-first SIWE/ENS/ERC-1271.
# PANOPTICON_ORACLES_BASE = attest origin (or origin+/api/v1[/oracles[/v0]]).
# Next hops POST /api/v1/oracles/v0/attest from session-gated /api/oracles/attest.
# Lab: https://api.test.hyperme.sh. Never NEXT_PUBLIC_*. Never Gun.
# Contract: FyberLabs/panopticon products/oracles/docs/oracles-attest-v0.md
# Ops / smoke: docs/oracles-and-payments-prep.md
PANOPTICON_ORACLES_BASE=

# Optional Panopticon payments access consume (receipt required, intent optional).
# Server-side only. Reuse PANOPTICON_TENANT_ID + PANOPTICON_API_KEY (same KV habit).
# PANOPTICON_PAYMENTS_BASE = origin (or origin+/api/v1[/payments[/v0]]).
# Lab: https://api.test.hyperme.sh
# Next hops POST /api/v1/payments/v0/receipt and optional /intent.
# SIWE session-gated: POST /api/payments/receipt and /api/payments/intent.
# Empty BASE / tenant / key (default) = fail-soft 503 payments-unconfigured.
# No hard paywall. Never create a SociACL grant. Never NEXT_PUBLIC_*. Never Gun.
# Not Stripe / core/payment-service. FyberLabs/infra owns the TF App Setting for BASE.
# Contract: FyberLabs/panopticon products/payments/docs/payments-access-v0.md
# Ops / smoke: docs/oracles-and-payments-prep.md
PANOPTICON_PAYMENTS_BASE=

# Optional email/SMS confirm webhook (server-side only). POST { kind, target, code }.
# Empty (default) is honest "not configured" for live send. Non-production uses
# lab fixture code 000000 unless CONFIRM_FIXTURE=0. Never NEXT_PUBLIC_*.
CONFIRM_SEND_URL=
CONFIRM_FIXTURE=

# Optional third-party KYC issuer HTTP (server-side only). Empty keeps the
# fixture issuer (`kyc:fixture:held`). There is no default vendor. Never NEXT_PUBLIC_*.
KYC_ISSUER_URL=

# Panopticon Keycloak issuer for the backup OAuth door. Public client s3rch-web.
# Empty (default) fails closed: the start route does not invent an issuer.
# Allowed when set: https://auth.test.hyperme.sh/realms/controlplane,
# https://auth.hyperme.sh/realms/controlplane, or local Keycloak on :8081.
# No client secret. Never NEXT_PUBLIC_*. Never Gun. Never a Hypermesh API key.
S3RCH_OAUTH_ISSUER=

# Development file for login handles (wallet addresses and Keycloak subjects
# on one checksummed owner). Default data/identity-links.json. Not a secret.
# Not Gun. Never NEXT_PUBLIC_*. Production does not read this path.
S3RCH_IDENTITY_LINKS=

# Production App Service settings for the same document in one private blob.
# Not used in development. No account key and no connection string.
# Auth is the App Service managed identity. See docs/identity-storage.md.
# S3RCH_IDENTITY_BLOB_ACCOUNT=
# S3RCH_IDENTITY_BLOB_CONTAINER=
